generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Bill {
  id           String   @id
  congress     Int
  number       String
  type         String
  title        String
  sponsor      String
  status       String
  introducedAt DateTime
  topicTags    String[]
  topicTagsSource String?  // "api" | "llm" | "keyword" | "none" | null (legacy)
  fullTextUrl  String?
  imageUrl     String?
  imageThumbnailUrl String?
  imageTitle   String?
  imagePageUrl String?
  imageCreator String?
  imageCreatorUrl String?
  imageLicense String?
  imageLicenseVersion String?
  imageSource  String?
  imageSearchQuery String?
  imageFetchedAt DateTime?
  viewCount    Int      @default(0)
  breakingAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  summary  Summary?
  stances  Stance[]
  feedback Feedback[]

  @@index([topicTags])
  @@index([status])
}

model Summary {
  id            String   @id @default(cuid())
  billId        String   @unique
  bill          Bill     @relation(fields: [billId], references: [id])
  plainLanguage String
  keyProvisions String[]
  whyItMatters  String   @default("")
  aiProvider    String?
  aiModel       String?
  generatedAt   DateTime @default(now())
  flagCount     Int      @default(0)
}

model Stance {
  id            String @id @default(cuid())
  billId        String
  bill          Bill   @relation(fields: [billId], references: [id])
  party         String
  position      String
  voteYes       Int    @default(0)
  voteNo        Int    @default(0)
  cosponsors    Int    @default(0)
  source        String

  @@index([billId])
}

model Organization {
  id        String   @id @default(cuid())
  name      String   @unique
  mission   String
  website   String?
  topicTags String[]
  location  String?
  events    Event[]
  createdAt DateTime @default(now())
}

model Event {
  id       String       @id @default(cuid())
  orgId    String
  org      Organization @relation(fields: [orgId], references: [id])
  title    String
  type     String
  date     DateTime
  location String
  rsvps    Rsvp[]
}

model Rsvp {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id])
  email   String
}

model Feedback {
  id        String   @id @default(cuid())
  billId    String
  bill      Bill     @relation(fields: [billId], references: [id])
  reason    String
  createdAt DateTime @default(now())
}

model Representative {
  id          String   @id @default(cuid())
  bioguideId  String   @unique
  firstName   String
  lastName    String
  party       String   // D, R, I
  chamber     String   // house, senate
  state       String
  district    String?  // For House members
  websiteUrl  String?
  phone       String?
  officeAddress String?
  photoUrl    String?
  lastScraped DateTime?
  createdAt   DateTime @default(now())
  
  stances     RepStance[]
}

model RepStance {
  id              String   @id @default(cuid())
  repId           String
  representative  Representative @relation(fields: [repId], references: [id])
  billId          String
  stance          String   // strong_support, possible_support, neutral, possible_reject, strong_reject
  confidence      Float    @default(0.5)
  reasoning       String?
  source          String   // scraped, inferred, vote
  scrapedAt       DateTime @default(now())
  
  @@unique([repId, billId])
  @@index([billId])
  @@index([stance])
}

model ScrapedContent {
  id          String   @id @default(cuid())
  repId       String
  url         String
  content     String   @db.Text
  scrapedAt   DateTime @default(now())
  
  @@index([repId])
  @@index([scrapedAt])
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  userId    String?  // Cookie-based user ID
  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
  @@index([userId])
}

model User {
  id              String   @id @default(cuid())
  email           String?  @unique
  cookieId        String   @unique
  interestSelections String[] @default([])
  emailSubscriptions String[] @default(["weekly"])
  topicWeights    Json     @default("{}")  // {"Healthcare": 5, "Education": 3}
  timezone        String?
  zipCode         String?
  preferredRepBioguideIds String[] @default([])
  welcomeEmailSentAt DateTime?
  onboardingDigestSentAt DateTime?
  lastSeen        DateTime @default(now())
  createdAt       DateTime @default(now())
  
  sessions        Session[]
  billViews       BillView[]
  emailDigests    EmailDigestLog[]
}

model EmailDigestLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  kind         String
  localDateKey String
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@unique([userId, kind, localDateKey])
}

model Session {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  startTime       DateTime @default(now())
  endTime         DateTime?
  pageCount       Int      @default(0)
  billsRead       Int      @default(0)
  
  @@index([userId])
}

model BillView {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  billId          String
  timeSpent       Int      @default(0)  // seconds
  scrollDepth     Int      @default(0)  // percentage
  viewedAt        DateTime @default(now())

  @@index([userId])
  @@index([billId])
  @@index([viewedAt])
}

model ZipDistrict {
  id        String   @id @default(cuid())
  zip       String   // 5-digit ZCTA
  stateCode String   // "DE", "CA"
  stateName String   // "Delaware", "California"
  district  String   // "1", "10"; "0" for at-large
  createdAt DateTime @default(now())

  @@unique([zip, stateCode, district])
  @@index([zip])
}
