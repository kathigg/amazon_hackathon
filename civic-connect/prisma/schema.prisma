generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Bill {
  id           String   @id
  congress     Int
  number       String
  type         String
  title        String
  sponsor      String
  status       String
  introducedAt DateTime
  topicTags    String[]
  fullTextUrl  String?
  viewCount    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  summary  Summary?
  stances  Stance[]
  feedback Feedback[]

  @@index([topicTags])
  @@index([status])
}

model Summary {
  id            String   @id @default(cuid())
  billId        String   @unique
  bill          Bill     @relation(fields: [billId], references: [id])
  plainLanguage String
  keyProvisions String[]
  whyItMatters  String   @default("")
  aiProvider    String?
  aiModel       String?
  generatedAt   DateTime @default(now())
  flagCount     Int      @default(0)
}

model Stance {
  id            String @id @default(cuid())
  billId        String
  bill          Bill   @relation(fields: [billId], references: [id])
  party         String
  position      String
  voteYes       Int    @default(0)
  voteNo        Int    @default(0)
  cosponsors    Int    @default(0)
  source        String

  @@index([billId])
}

model Organization {
  id        String   @id @default(cuid())
  name      String   @unique
  mission   String
  website   String?
  topicTags String[]
  location  String?
  events    Event[]
  createdAt DateTime @default(now())
}

model Event {
  id       String       @id @default(cuid())
  orgId    String
  org      Organization @relation(fields: [orgId], references: [id])
  title    String
  type     String
  date     DateTime
  location String
  rsvps    Rsvp[]
}

model Rsvp {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id])
  email   String
}

model Feedback {
  id        String   @id @default(cuid())
  billId    String
  bill      Bill     @relation(fields: [billId], references: [id])
  reason    String
  createdAt DateTime @default(now())
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  userId    String?  // Cookie-based user ID
  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
  @@index([userId])
}

model User {
  id              String   @id @default(cuid())
  cookieId        String   @unique
  topicWeights    Json     @default("{}")  // {"Healthcare": 5, "Education": 3}
  lastSeen        DateTime @default(now())
  createdAt       DateTime @default(now())
  
  sessions        Session[]
  billViews       BillView[]
}

model Session {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  startTime       DateTime @default(now())
  endTime         DateTime?
  pageCount       Int      @default(0)
  billsRead       Int      @default(0)
  
  @@index([userId])
}

model BillView {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  billId          String
  timeSpent       Int      @default(0)  // seconds
  scrollDepth     Int      @default(0)  // percentage
  viewedAt        DateTime @default(now())
  
  @@index([userId])
  @@index([billId])
  @@index([viewedAt])
}
