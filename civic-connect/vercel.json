{
  "framework": "nextjs",
  "buildCommand": "npx prisma generate && npx prisma db push --accept-data-loss && next build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/ingest",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/scrape/representatives",
      "schedule": "0 9 * * *"
    }
  ]
}
