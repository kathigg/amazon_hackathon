CONGRESS_API_KEY=your_congress_api_key
GOOGLE_CIVIC_API_KEY=your_google_civic_api_key
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/civicconnect"
INGEST_SECRET=any_random_string
CRON_SECRET=any_random_string

# AI Summarization runs on Amazon Bedrock (see lib/summarize.ts and lib/aws-bedrock.ts).
# Provide either a bearer token OR IAM keys — bearer token is preferred for local dev.
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL=amazon.nova-micro-v1:0
# AWS_BEDROCK_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0  # alt: Claude Haiku 4.5
# AWS_BEARER_TOKEN_BEDROCK=your_bedrock_api_key_here
# AWS_ACCESS_KEY_ID=your_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_here

# Email (Amazon SES)
APP_BASE_URL=http://localhost:3000
# SES_FROM_EMAIL=news@civicconnect.net
# SES_REPLY_TO=team@civicconnect.net

# Self-hosted bill image pool — see scripts/curate-images.ts.
# Pick ONE storage backend.
#
# Local filesystem (no AWS): images written under public/curated-images/, served
# by Next.js as /curated-images/... Easy to start, easy to seed prod via DB
# replication and Docker image. Bigger Docker images though.
# IMAGE_LOCAL_DIR=public/curated-images
#
# S3 + CDN (production pattern, requires @aws-sdk/client-s3 installed): bytes go
# to the bucket, browsers fetch from the CDN host directly.
# IMAGE_S3_BUCKET=civic-connect-images
# IMAGE_CDN_HOST=https://images.civicconnect.net

# Legacy keys — no longer wired into the app, kept here only for reference.
# Earlier revisions used Google Gemini / Anthropic / OpenAI direct providers via @ai-sdk.
# GOOGLE_GEMINI_KEY=your_gemini_key_here
# ANTHROPIC_API_KEY=your_key_here
# OPENAI_API_KEY=your_key_here
