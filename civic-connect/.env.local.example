CONGRESS_API_KEY=your_congress_api_key
GOOGLE_CIVIC_API_KEY=your_google_civic_api_key
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/civicconnect"
INGEST_SECRET=any_random_string

# AI Summarization — pick a provider
AI_PROVIDER=google          # "ollama", "google", "anthropic", or "openai"
AI_MODEL=gemini-2.0-flash   # model name for chosen provider

# For local dev with GPU:
# AI_PROVIDER=ollama
# AI_MODEL=qwen3:0.6b

# Provider API keys (only need the one matching AI_PROVIDER)
GOOGLE_GEMINI_KEY=your_gemini_key_here
# ANTHROPIC_API_KEY=your_key_here
# OPENAI_API_KEY=your_key_here

# AWS Bedrock (either bearer token or IAM keys)
# AWS_BEARER_TOKEN_BEDROCK=your_bedrock_api_key_here
# AWS_ACCESS_KEY_ID=your_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_here
# AWS_REGION=us-east-1
# AWS_BEDROCK_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Email
# APP_BASE_URL=https://www.civicconnect.net
# SES_FROM_EMAIL=news@civicconnect.net
# SES_REPLY_TO=team@civicconnect.net
